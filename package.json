{
  "name": "shankarmala-gemstore",
  "version": "1.0.0",
  "description": "Luxury gemstone e-commerce platform",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:custom": "node dev-server.js",
    "build": "node scripts/optimize-css.js && next build",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start",
    "start:custom": "node server.js",
    "start:simple": "node simple-server.js",
    "start:static": "node serve-static.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "docker:build": "docker build -t gemstone-store .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prod:setup": "npm ci --only=production && prisma generate && prisma migrate deploy",
    "prod:start": "npm run prod:setup && npm run start:prod",
    "health": "node scripts/health-check.js",
    "performance:report": "node scripts/generate-performance-report.js",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:all": "rm -rf .next out node_modules package-lock.json && npm install",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "prepare": "husky install || true",
    "build:optimized": "node scripts/optimize-css.js && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.16.4",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.294.0",
    "next": "^15.5.3",
    "next-auth": "^4.24.5",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.17.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^3.1.2",
    "socket.io": "^4.8.1",
    "stripe": "^14.7.0",
    "tailwindcss": "^3.3.6",
    "uuid": "^9.0.1",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sentry/node": "^10.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "autoprefixer": "^10.4.16",
    "cssnano-cli": "^1.0.5",
    "eslint": "^8.53.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "hot-shots": "^11.2.0",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prisma": "^6.14.0",
    "purgecss": "^7.0.2",
    "sharp": "^0.34.3",
    "terser-webpack-plugin": "^5.3.14",
    "tsx": "^4.6.2",
    "typescript": "5.3.3",
    "vitest": "^3.2.4",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "keywords": [
    "gemstones",
    "e-commerce",
    "luxury",
    "jewelry",
    "nextjs",
    "react"
  ],
  "author": "Shankarmala Team",
  "license": "MIT"
}
