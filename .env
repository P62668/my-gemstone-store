# THIS FILE IS COMMITTED FOR EXAMPLE PURPOSES ONLY
# Rename to `.env` locally and populate with real secrets. DO NOT COMMIT real secrets to the repository.

# Database (production should use a managed Postgres DB)
# Example: postgresql://username:password@host:5432/database
DATABASE_URL=file:./prisma/dev.db

# JWT / Auth secrets
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_NEXTAUTH_SECRET

# Stripe (example placeholders)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Admin Configuration (do NOT commit production admin password)
ADMIN_EMAIL=admin@shankarmala.com
ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD

# App URL used by NextAuth for callbacks (use real URL in production)
NEXTAUTH_URL=http://localhost:3000

# Optional: Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# IMPORTANT:
#  - Treat this file as an example. Create a local `.env` (not committed) with real secrets.
#  - If you've accidentally committed secrets in git history, rotate them and purge history.
#  - CI uses GitHub Secrets. Do not rely on an in-repo `.env` for CI/production.