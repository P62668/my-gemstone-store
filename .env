# Database
DATABASE_URL=file:/Users/p62668/my-gemstone-store/prisma/dev.db

# JWT Secret for authentication
JWT_SECRET="REPLACE_WITH_SECURE_JWT_SECRET"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Admin Configuration
ADMIN_EMAIL="admin@shankarmala.com"
ADMIN_PASSWORD="REPLACE_WITH_SECURE_ADMIN_PASSWORD"

# Next.js Configuration
# Set to the local dev server URL so NextAuth callbacks use the correct host/port during development
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_NEXTAUTH_SECRET"

# Optional: Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# NOTE: Removed PRISMA_CLIENT_ENGINE_TYPE and PRISMA_WASM_ENGINE_THREADS to avoid forcing the WASM/daemon engine
# Prisma will now select the best available engine (binary/library) on startup.