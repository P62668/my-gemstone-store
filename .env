# Development Environment Variables for Shankarmala Gemstore
# Copy .env.example to create this file with all available options

#================================================================
# ESSENTIAL CONFIGURATION
#================================================================

# Environment
NODE_ENV="development"
PORT="3000"

# Application
SITE_NAME="Shankarmala"
SITE_URL="http://localhost:3000"
PUBLIC_BASE_URL="http://localhost:3000"

# Database
DATABASE_URL="file:./dev.db"

# Authentication (Development - Use secure keys in production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-key-change-in-production-32-chars"
JWT_SECRET="dev-jwt-secret-change-in-production-32-chars"

# Security Configuration
# Rate Limiting
RATE_LIMIT_WINDOW="900000"
RATE_LIMIT_MAX="100"
API_RATE_LIMIT_MAX="50"
ADMIN_RATE_LIMIT_MAX="200"

# Session Security
SESSION_MAX_AGE="604800"
SESSION_UPDATE_AGE="86400"

# Password Security
PASSWORD_MIN_LENGTH="12"
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_LOWERCASE="true"
PASSWORD_REQUIRE_NUMBERS="true"
PASSWORD_REQUIRE_SPECIAL_CHARS="true"

# Security Headers
ENABLE_SECURITY_HEADERS="true"
CORS_ORIGIN="http://localhost:3000"
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com https://*.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com;"
STRICT_TRANSPORT_SECURITY="max-age=31536000; includeSubDomains; preload"
PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=()"

# Admin Security
ADMIN_EMAIL="admin@shankarmala.com"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_TIMEOUT="3600"
ADMIN_MFA_ENABLED="false"

# Payment Processing (Development keys)
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
DEFAULT_CURRENCY="USD"
ENABLE_COD="true"
ENABLE_MOCK_PAYMENTS="true"

# Email Configuration (Development)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@shankarmala.com"
EMAIL_SECURE="false"

# File Upload
UPLOAD_DIR="./public/images/uploads"
MAX_FILE_SIZE="5242880"
ALLOWED_FILE_TYPES="jpg,jpeg,png,webp"

# Admin Configuration
ADMIN_EMAIL="admin@shankarmala.com"
ADMIN_PASSWORD="admin123"

# Performance & Caching
CACHE_TTL="3600"
STATIC_CACHE_TTL="86400"

# Feature Flags
ENABLE_WISHLIST="true"
ENABLE_REVIEWS="true"
ENABLE_RECOMMENDATIONS="true"
ENABLE_CART_PERSISTENCE="true"
ENABLE_GUEST_CHECKOUT="true"
ENABLE_DEV_TOOLS="true"
ENABLE_DEBUG_LOGGING="false"
